# .env.example — names only, never values. See docs/SECURITY.md and docs/DEPLOYMENT.md.

# App
NEXT_PUBLIC_SITE_URL=

# Neon PostgreSQL (docs/ARCHITECTURE.md #database)
DATABASE_URL=

# Auth (passwordless email OTP/magic link + GitHub OAuth — ADR-014)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ZeptoMail (transactional email only)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloudflare Turnstile (bot protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Scheduled jobs (ADR-018 prune and rollup, triggered over HTTP)
JOB_TRIGGER_SECRET=
